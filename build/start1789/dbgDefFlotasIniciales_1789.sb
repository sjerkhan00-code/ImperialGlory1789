
############################################################################################
# 1789 world: additional starting fleets (build/start1789/gen_start1789.py)
# Append these blocks / entries to Game/GameModes/Gestion/dbgDefFlotasIniciales.sb.
# Players that already have a block (GB, Spain, Portugal, France, Russia, Batavia) need the
# entries merged INTO their existing block (one block per JUG_ key).
############################################################################################

.JUG_GRAN_BRETANYA
[
 [ # Royal Navy East Indies squadron, Madras
  .NOMBRE        "Fleet ING East Indies"
  .PROVINCIA     S_COROMANDEL_COAST
  .BARCO_INICIAL FRAGATA
  .BARCOS        [ CORBETA ]
 ]
 [ # EIC Bombay Marine
  .NOMBRE        "Fleet ING Bombay Marine"
  .PROVINCIA     S_MALABAR_COAST
  .BARCO_INICIAL CORBETA
 ]
 [ # HMS Sirius of the First Fleet
  .NOMBRE        "Fleet ING Sirius"
  .PROVINCIA     S_COAST_OF_NEW_SOUTH_WALES
  .BARCO_INICIAL CORBETA
 ]
]

